  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "title": "Live Ticket Inventory (Redis)",
      "type": "gauge",
      "targets": [
        {
          "expr": "ticketpulse_inventory_remaining",
          "legendFormat": "Tickets in Stock",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "title": "Total Successful Bookings",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(ticketpulse_bookings_total{status=\"success\"}) or vector(0)",
          "legendFormat": "Tickets Sold",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "title": "Real-time Traffic (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ticketpulse_request_latency_seconds_count[10s])) by (endpoint)",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    }
  ],
